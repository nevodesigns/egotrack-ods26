# the address judges and traders use, e.g. 102-209-47-247.sslip.io, or the
# free .com.ng domain once issued
APP_DOMAIN=
APP_URL=https://

# a long random string; generate it on the server with: openssl rand -hex 32
SESSION_SECRET=

AI_PROVIDER=gemini
GEMINI_API_KEY=
BACKUP_AI_KEY=
DEMO_ENABLED=true
